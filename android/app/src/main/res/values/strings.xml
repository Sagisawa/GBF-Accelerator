    <string name="cache_export_download">导出至 Download 目录</string>
    <string name="cache_clear_dialog_title">确认清空全部静态缓存？</string>
    <string name="cache_clear_dialog_msg">将彻底删除本地存储的所有 GBF 静态素材（图片、音频、JS等）。\n下次进入游戏将重新从 CDN 透明下载并重建缓存。</string>
    <string name="cache_slim_dialog_title">确认执行缓存智能瘦身？</string>
    <string name="cache_slim_dialog_msg">核心将自动分析静态素材版本链，修剪失效的历史旧版本文件并释放存储空间，保留最新版本素材。</string>
    <string name="dialog_confirm">确认执行</string>
    <string name="dialog_cancel">取消</string>

    <!-- Performance & Cache Preferences -->
    <string name="section_pref_title">性能与缓存偏好设置</string>
    <string name="pref_ram_cache_title">RAM 内存缓存</string>
    <string name="pref_ram_cache_desc">将高频热点静态素材缓存至应用内存中。移动设备内存资源有限，默认关闭以减少 RAM 占用并依靠本地磁盘缓存加速。</string>
    <string name="pref_prefetch_title">静态素材后台预加载</string>
    <string name="pref_prefetch_desc">在后台自动解析页面静态依赖并平滑预拉取。在移动网络或部分机型上可能带来额外开销，默认关闭以确保流畅稳定。</string>

